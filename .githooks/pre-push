#!/bin/sh
# git pre-push hook: the whole `npm run check` (tools/check.mjs header) before
# anything leaves this machine, so a push fails on what the pull request's CI
# would fail on. `npm install` points git here (package.json's `prepare`
# script sets core.hooksPath). `git push --no-verify` skips it.
top=$(git rev-parse --show-toplevel) || exit 0
cd "$top" || exit 0
[ -f tools/check.mjs ] || exit 0
if [ ! -d node_modules ]; then
  echo "pre-push: no node_modules in $top, so npm run check can't run here. Run npm ci; CI still checks the pull request." >&2
  exit 0
fi
echo "pre-push: npm run check" >&2
node tools/check.mjs

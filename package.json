{
  "name": "sine-visuals-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "Yaroslav Maksymenko",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "predev": "node tools/private-scenes.mjs",
    "dev": "vite",
    "predev:host": "node tools/private-scenes.mjs",
    "dev:host": "vite --host",
    "dev:worker": "wrangler dev --port 8787 --local-protocol https --local-upstream localhost:8787",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -b server",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:tempo": "vitest run tests/tempoEval.test.ts"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "dseg": "^0.46.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}

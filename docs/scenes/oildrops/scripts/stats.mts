import { createDropSim, stepDrops, DRIFT_SPEED, EDDY_BASE, dropCount } from "../../../../src/render/scenes/oildrops/drops.ts";
const A = 9/16;
function stats(seed, speed, count) { const sim = createDropSim(seed); const p = { aspect: A, count, size: 1, nested: 0.5, paint: 0, speed, eddy: EDDY_BASE, shove: 0, pour: 0 }; const rows = []; for (let f = 0; f < 1800; f++) { stepDrops(sim, 1/60, p); if (f >= 600 && f % 60 === 0) { const on = sim.drops.filter(d => d.x > -d.r && d.x < 1 + d.r && d.y > -d.r && d.y < A + d.r); const rs = on.map(d => d.r * 100).sort((a,b)=>a-b); const big = rs.filter(r => r >= 12/19.2).length; let cover = 0; const W = 192, H = 108; for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) { const px = (x+0.5)/W, py = (y+0.5)/H*A; if (on.some(d => d.host < 0 && (d.x-px)**2 + (d.y-py)**2 < d.r*d.r)) cover++; } const inner = on.filter(d => d.host >= 0).length; const hosts = on.filter(d => d.host < 0 && d.r >= 24/1920); const nested = on.filter(d => d.host >= 0 && sim.drops[d.host].r >= 24/1920).length; let touching = 0, nbig = 0; for (const d of on) { if (d.r < 12/1920 || d.host >= 0) continue; nbig++; if (on.some(e => e !== d && e.host < 0 && Math.hypot(d.x-e.x, d.y-e.y) < d.r + e.r + 0.001)) touching++; } const speeds = on.filter(d=>d.host<0).map(d => Math.hypot(d.vx, d.vy)*100).sort((a,b)=>a-b); rows.push({ n: on.length, big, cover: cover/(W*H), med: rs[rs.length>>1], p90: rs[Math.floor(rs.length*0.9)], max: rs[rs.length-1], touch: touching/Math.max(1,nbig), nest: nested/Math.max(1,hosts.length), spd: speeds[speeds.length>>1] }); } } const med = k => { const v = rows.map(r => r[k]).sort((a,b)=>a-b); return v[v.length>>1]; }; return Object.fromEntries(Object.keys(rows[0]).map(k => [k, +med(k).toFixed(3)])); }
console.log("quiet, Drops default:", JSON.stringify(stats(1, DRIFT_SPEED*0.3, dropCount(0.5))));
console.log("quiet, seed 2:", JSON.stringify(stats(2, DRIFT_SPEED*0.3, dropCount(0.5))));
console.log("loud sweep (rush 1, level 1):", JSON.stringify(stats(3, DRIFT_SPEED*0.3*13, dropCount(0.5))));
console.log("Drops 1:", JSON.stringify(stats(4, DRIFT_SPEED*0.3, dropCount(1))));
